# Managed by RF433 Button Manager installer. Existing values survive upgrades.
# Initial HTTP listener. Confirmed Settings > Network access overrides this
# through private network.json in the data directory. Default is loopback.
RFB_LISTEN=127.0.0.1:8787
RFB_RTL433=/usr/bin/rtl_433
# Optional exact HTTPS browser origin for an explicitly configured reverse proxy.
# Example: RFB_PUBLIC_ORIGIN=https://rf.home.example
# Leave empty for direct HTTP, built-in HTTPS or an SSH tunnel.
RFB_PUBLIC_ORIGIN=
