# Managed by RF Button Manager installer. Existing values survive upgrades.
# Keep loopback binding and use an SSH tunnel, or explicitly configure a private IP.
RFB_LISTEN=127.0.0.1:8787
RFB_RTL433=/usr/bin/rtl_433
# Optional exact HTTPS browser origin for an explicitly configured reverse proxy.
# Example: RFB_PUBLIC_ORIGIN=https://rf.home.example
# Leave empty for direct HTTP access or the recommended SSH tunnel.
RFB_PUBLIC_ORIGIN=
